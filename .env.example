# Cấu hình chạy trên máy cá nhân.
DJANGO_SETTINGS_MODULE=core.settings
DEBUG=True
SECRET_KEY=django-insecure-local-development-only-change-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Địa chỉ frontend được phép gọi API; để trống nếu chỉ thử API bằng curl/Postman.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mặc định dùng SQLite. Chỉ điền nhóm dưới đây khi chuyển sang PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=django
POSTGRES_PASSWORD=local-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Thời hạn của access token (phút) và refresh token (ngày).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Chỉ bật nếu triển khai sau reverse proxy tin cậy.
TRUST_PROXY_SSL_HEADER=False
